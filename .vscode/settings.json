{
  "[markdown]": {
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": "off"
    },
    "editor.tabCompletion": "on"
  },
  "explorer.compactFolders": false,
  "git.enableSmartCommit": true,
  "git.smartCommitChanges": "all",
  "git.postCommitCommand": "sync",
  "git.confirmSync": false,
  "git.autofetch": true
}
